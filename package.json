{
  "name": "smag-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate:screens": "node scripts/generate-screens.mjs",
    "seed:external": "node scripts/seed-external-restaurants.mjs",
    "seed:external:write": "node scripts/seed-external-restaurants.mjs --write",
    "lint": "expo lint",
    "test": "node ./node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watch",
    "test:e2e-smoke": "node scripts/e2e-smoke.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!.*react-native|.*expo|.*@react-native)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "^55.0.15",
    "expo-crypto": "~15.0.8",
    "expo-device": "^55.0.15",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-haptics": "^55.0.14",
    "expo-image": "^55.0.9",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "^55.0.14",
    "expo-local-authentication": "^55.0.13",
    "expo-location": "^18.0.10",
    "react-native-maps": "^1.14.0",
    "expo-notifications": "^55.0.21",
    "expo-router": "~5.1.0",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~15.0.10",
    "firebase": "^11.6.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-web": "0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^55.0.18",
    "eslint": "9.38.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~5.9.2"
  }
}
