[debug] [2026-05-02T13:54:00.774Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/smag-12fe9/rulesets {"name":"projects/smag-12fe9/rulesets/32cf05db-27fd-4e4e-994d-046b62d2b0f3","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function authEmail() {\n      return isSignedIn() && request.auth.token.email is string\n        ? request.auth.token.email\n        : \"\";\n    }\n\n    function hasAdminProfile() {\n      return isSignedIn() &&\n        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));\n    }\n\n    function adminRoleName() {\n      return hasAdminProfile()\n        ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.roleName\n        : \"\";\n    }\n\n    function roleNameRank(roleName) {\n      return roleName is string && roleName.matches('(?i)^(admin|owner)$')\n        ? 2\n        : roleName is string && roleName.matches('(?i)^(sub-admin|subadmin|manager)$')\n          ? 1\n          : 0;\n    }\n\n    function adminRank() {\n      return roleNameRank(adminRoleName());\n    }\n\n    function isAdmin() {\n      return hasAdminProfile() && adminRank() >= 2;\n    }\n\n    function isAdminOrSubAdmin() {\n      return hasAdminProfile() && adminRank() >= 1;\n    }\n\n    function roleRank(data) {\n      return data.rank is int\n        ? data.rank\n        : roleNameRank(data.name);\n    }\n\n    function isKitchenOwner() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/kitchen_owners/$(request.auth.uid));\n    }\n\n    function ownsRestaurant(restaurantId) {\n      return restaurantId is string\n        && exists(/databases/$(database)/documents/external_restaurants/$(restaurantId))\n        && get(/databases/$(database)/documents/external_restaurants/$(restaurantId)).data.ownerUid == request.auth.uid;\n    }\n\n    function hasEmployeeProfile() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/employees/$(request.auth.uid));\n    }\n\n    function employeeProfile() {\n      return hasEmployeeProfile()\n        ? get(/databases/$(database)/documents/employees/$(request.auth.uid)).data\n        : null;\n    }\n\n    function employeeRoleId() {\n      return employeeProfile() != null && employeeProfile().roleId is string\n        ? employeeProfile().roleId\n        : \"\";\n    }\n\n    function employeeRoleName() {\n      return employeeRoleId() != \"\"\n        && exists(/databases/$(database)/documents/roles/$(employeeRoleId()))\n        ? get(/databases/$(database)/documents/roles/$(employeeRoleId())).data.name\n        : \"\";\n    }\n\n    function employeePermissions() {\n      return employeeRoleId() != \"\"\n        && exists(/databases/$(database)/documents/roles/$(employeeRoleId()))\n        && get(/databases/$(database)/documents/roles/$(employeeRoleId())).data.permissions is list\n        ? get(/databases/$(database)/documents/roles/$(employeeRoleId())).data.permissions\n        : [];\n    }\n\n    function hasEmployeePermission(permission) {\n      return employeeProfile() != null\n        && employeeProfile().status == \"active\"\n        && permission in employeePermissions();\n    }\n\n    function isManagerEmployee() {\n      return hasEmployeePermission(\"business_team\")\n        || (employeeRoleName() is string && employeeRoleName().matches('(?i)manager'));\n    }\n\n    function isKitchenStaffEmployee() {\n      return hasEmployeePermission(\"business_orders\")\n        || (employeeRoleName() is string && employeeRoleName().matches('(?i)^kitchen[ -]?staff$'));\n    }\n\n    function isDriverEmployee() {\n      return hasEmployeePermission(\"business_driver\")\n        || (employeeRoleName() is string && employeeRoleName().matches('(?i)(driver|delivery)'));\n    }\n\n    function isConciergeEmployee() {\n      return hasEmployeePermission(\"business_support\")\n        || (employeeRoleName() is string && employeeRoleName().matches('(?i)(concierge|support)'));\n    }\n\n    function canReadOpsOrders() {\n      return hasAdminProfile()\n        || isManagerEmployee()\n        || isKitchenStaffEmployee()\n        || isConciergeEmployee();\n    }\n\n    function validRolePayload() {\n      return request.resource.data.name is string\n        && request.resource.data.description is string\n        && request.resource.data.permissions is list\n        && (request.resource.data.rank == null || request.resource.data.rank is int)\n        && (request.resource.data.adminScope == null || request.resource.data.adminScope is bool);\n    }\n\n    function validAdminInvitePayload() {\n      return request.resource.data.email is string\n        && request.resource.data.roleName is string\n        && request.resource.data.used is bool\n        && request.resource.data.createdByUid is string\n        && request.resource.data.createdAtIso is string;\n    }\n\n    function validAuditLogPayload() {\n      return request.resource.data.actorUid is string\n        && request.resource.data.actorName is string\n        && request.resource.data.actorEmail is string\n        && request.resource.data.action is string\n        && request.resource.data.targetType is string\n        && request.resource.data.targetId is string\n        && request.resource.data.targetLabel is string\n        && request.resource.data.details is string\n        && request.resource.data.createdAtIso is string;\n    }\n\n    function inviteExists(inviteId) {\n      return exists(/databases/$(database)/documents/admin_invites/$(inviteId));\n    }\n\n    function inviteDoc(inviteId) {\n      return get(/databases/$(database)/documents/admin_invites/$(inviteId)).data;\n    }\n\n    function validEmployeePayload() {\n      return request.resource.data.name is string\n        && request.resource.data.email is string\n        && request.resource.data.phone is string\n        && request.resource.data.roleId is string\n        && request.resource.data.status in [\"active\", \"suspended\"];\n    }\n\n    function validCategoryPayload() {\n      return request.resource.data.name is string\n        && request.resource.data.description is string\n        && request.resource.data.imageUrl is string\n        && request.resource.data.isActive is bool;\n    }\n\n    function validFoodPayload() {\n      return request.resource.data.name is string\n        && request.resource.data.description is string\n        && request.resource.data.categoryId is string\n        && request.resource.data.price is number\n        && request.resource.data.stock is number\n        && request.resource.data.imageUrl is string\n        && request.resource.data.status in [\"active\", \"hidden\"];\n    }\n\n    match /admin_users/{uid} {\n      allow create: if isSignedIn()\n        && request.auth.uid == uid\n        && request.resource.data.uid == uid\n        && request.resource.data.email == authEmail()\n        && request.resource.data.name is string\n        && request.resource.data.roleName is string\n        && roleNameRank(request.resource.data.roleName) >= 1\n        && request.resource.data.inviteId is string\n        && inviteExists(request.resource.data.inviteId)\n        && inviteDoc(request.resource.data.inviteId).used == false\n        && inviteDoc(request.resource.data.inviteId).email == authEmail()\n        && inviteDoc(request.resource.data.inviteId).roleName == request.resource.data.roleName;\n\n      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());\n\n      allow update: if isSignedIn() && (\n        (\n          isAdmin()\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.email == resource.data.email\n          && request.resource.data.inviteId == resource.data.inviteId\n          && roleNameRank(request.resource.data.roleName) >= 1\n          && roleNameRank(request.resource.data.roleName) <= adminRank()\n        )\n        || (\n          request.auth.uid == uid\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.email == resource.data.email\n          && request.resource.data.roleName == resource.data.roleName\n          && request.resource.data.inviteId == resource.data.inviteId\n        )\n      );\n\n      allow delete: if isAdmin() && roleNameRank(resource.data.roleName) < adminRank();\n    }\n\n    match /admin_invites/{inviteId} {\n      allow read: if hasAdminProfile() && (\n        isAdmin()\n        || (resource.data.email is string && resource.data.email == authEmail())\n      );\n\n      allow create: if isAdmin()\n        && validAdminInvitePayload()\n        && roleNameRank(request.resource.data.roleName) >= 1\n        && roleNameRank(request.resource.data.roleName) <= adminRank();\n\n      allow update: if isSignedIn() && (\n        (\n          isAdmin()\n          && request.resource.data.email is string\n          && request.resource.data.roleName is string\n          && request.resource.data.used is bool\n          && request.resource.data.createdByUid == resource.data.createdByUid\n          && request.resource.data.createdAtIso == resource.data.createdAtIso\n        )\n        || (\n          request.auth.uid != null\n          && resource.data.email == authEmail()\n          && resource.data.used == false\n          && request.resource.data.used == true\n          && request.resource.data.email == resource.data.email\n          && request.resource.data.roleName == resource.data.roleName\n          && request.resource.data.createdByUid == resource.data.createdByUid\n          && request.resource.data.createdAtIso == resource.data.createdAtIso\n          && request.resource.data.usedByUid == request.auth.uid\n          && request.resource.data.usedByEmail == authEmail()\n          && request.resource.data.usedAtIso is string\n        )\n      );\n\n      allow delete: if isAdmin();\n    }\n\n    match /roles/{roleId} {\n      allow read: if isSignedIn();\n      allow create: if isAdminOrSubAdmin()\n        && validRolePayload()\n        && (\n          roleRank(request.resource.data) < adminRank()\n          || (\n            isAdmin()\n            && request.resource.data.name is string\n            && request.resource.data.name.matches('(?i)^admin$')\n            && roleRank(request.resource.data) == adminRank()\n          )\n        );\n      allow update: if isAdminOrSubAdmin()\n        && validRolePayload()\n        && roleRank(resource.data) < adminRank()\n        && roleRank(request.resource.data) < adminRank();\n      allow delete: if isAdminOrSubAdmin() && roleRank(resource.data) < adminRank();\n    }\n\n    match /employees/{employeeId} {\n      allow read: if hasAdminProfile()\n        || isManagerEmployee()\n        || (isSignedIn() && (request.auth.uid == employeeId || resource.data.uid == request.auth.uid));\n      allow create, delete: if isAdminOrSubAdmin() && validEmployeePayload();\n      allow update: if (\n          isAdminOrSubAdmin()\n          && validEmployeePayload()\n        )\n        || (\n          isSignedIn()\n          && resource.data.uid == request.auth.uid\n          && request.resource.data.uid == resource.data.uid\n          && request.resource.data.name == resource.data.name\n          && request.resource.data.email == resource.data.email\n          && request.resource.data.phone == resource.data.phone\n          && request.resource.data.roleId == resource.data.roleId\n          && request.resource.data.status == resource.data.status\n        );\n    }\n\n    match /categories/{categoryId} {\n      allow read: if hasAdminProfile();\n      allow create, update, delete: if isAdminOrSubAdmin() && validCategoryPayload();\n    }\n\n    match /foods/{foodId} {\n      allow read: if hasAdminProfile();\n      allow create, update, delete: if isAdminOrSubAdmin() && validFoodPayload();\n    }\n\n    match /admin_audit_logs/{logId} {\n      allow read: if hasAdminProfile();\n      allow create: if hasAdminProfile()\n        && request.resource.data.actorUid == request.auth.uid\n        && request.resource.data.actorEmail == authEmail()\n        && validAuditLogPayload();\n      allow update, delete: if false;\n    }\n\n    match /menu_items/{itemId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /promotions/{promoId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /carts/{cartItemId} {\n      allow read, delete, update: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow create: if isSignedIn()\n        && request.auth.uid == request.resource.data.userId;\n    }\n\n    match /orders/{orderId} {\n      allow read: if isSignedIn() && (\n        request.auth.uid == resource.data.userId\n        || canReadOpsOrders()\n        || (resource.data.assignedDriverUid is string && resource.data.assignedDriverUid == request.auth.uid)\n        || (isDriverEmployee() && resource.data.assignedDriverUid == null && resource.data.status == \"on_delivery\")\n        || (resource.data.restaurantId is string && ownsRestaurant(resource.data.restaurantId))\n      );\n      allow create: if isSignedIn()\n        && request.auth.uid == request.resource.data.userId\n        && request.resource.data.status in [\"confirmed\", \"pending_payment\"];\n      allow update: if isSignedIn()\n        && request.auth.uid == resource.data.userId\n        && request.resource.data.userId == resource.data.userId\n        && request.resource.data.status == resource.data.status\n        && request.resource.data.paymentStatus == resource.data.paymentStatus\n        && request.resource.data.paymentReference == resource.data.paymentReference;\n    }\n\n    match /payments/{paymentId} {\n      allow read: if isSignedIn()\n        && resource.data.userId == request.auth.uid;\n      allow write: if false;\n    }\n\n    match /app_config/{docId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /notifications/{notificationId} {\n      allow read, update: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow create: if false;\n    }\n\n    match /users/{uid} {\n      allow read, write: if isSignedIn() && request.auth.uid == uid;\n    }\n\n    match /addresses/{addressId} {\n      allow read, delete, update: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow create: if isSignedIn()\n        && request.auth.uid == request.resource.data.userId;\n    }\n\n    match /points_history/{entryId} {\n      allow read: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow write: if false;\n    }\n\n    match /external_restaurants/{restaurantId} {\n      allow read: if isSignedIn();\n      allow create, delete: if hasAdminProfile();\n      allow update: if hasAdminProfile()\n        || (\n          isKitchenOwner()\n          && ownsRestaurant(restaurantId)\n          && request.resource.data.ownerUid == resource.data.ownerUid\n        );\n    }\n\n    match /external_menu_items/{itemId} {\n      allow read: if isSignedIn();\n      allow create: if hasAdminProfile()\n        || (\n          isKitchenOwner()\n          && request.resource.data.restaurantId is string\n          && ownsRestaurant(request.resource.data.restaurantId)\n        );\n      allow update: if hasAdminProfile()\n        || (\n          isKitchenOwner()\n          && resource.data.restaurantId == request.resource.data.restaurantId\n          && ownsRestaurant(resource.data.restaurantId)\n        );\n      allow delete: if hasAdminProfile()\n        || (\n          isKitchenOwner()\n          && ownsRestaurant(resource.data.restaurantId)\n        );\n    }\n\n    match /promo_codes/{promoId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /kitchen_applications/{appId} {\n      allow create: if request.auth != null\n        && request.resource.data.email is string\n        && request.resource.data.businessName is string\n        && request.resource.data.status == \"pending\";\n      allow read: if hasAdminProfile();\n      allow update, delete: if false;\n    }\n\n    match /kitchen_owners/{uid} {\n      allow read: if isSignedIn() && (request.auth.uid == uid || hasAdminProfile());\n      allow update: if isSignedIn()\n        && request.auth.uid == uid\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.restaurantId == resource.data.restaurantId\n        && request.resource.data.restaurantName == resource.data.restaurantName\n        && request.resource.data.role == resource.data.role;\n      allow create, delete: if false;\n    }\n\n    match /mail/{docId} {\n      allow read, write: if false;\n    }\n\n    match /broadcast_notifications/{docId} {\n      allow read: if hasAdminProfile();\n      allow write: if false;\n    }\n\n    match /app_broadcasts/{docId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /vip_chat_sessions/{sessionId} {\n      allow read, create: if isSignedIn();\n      allow update: if isSignedIn();\n    }\n\n    match /vip_chat_sessions/{sessionId}/messages/{msgId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn()\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0;\n    }\n\n    match /order_reviews/{reviewId} {\n      allow create: if isSignedIn()\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.foodRating is number\n        && request.resource.data.driverRating is number;\n      allow read: if hasAdminProfile();\n      allow update, delete: if false;\n    }\n\n    match /driver_applications/{appId} {\n      allow create: if request.resource.data.email is string\n        && request.resource.data.name is string\n        && request.resource.data.status == \"pending\";\n      allow read: if hasAdminProfile();\n      allow update, delete: if false;\n    }\n\n    match /favorites/{favId} {\n      allow read, delete: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow create: if isSignedIn()\n        && request.auth.uid == request.resource.data.userId\n        && favId == request.auth.uid + \"_\" + request.resource.data.menuItemId;\n    }\n\n    match /referrals/{referralId} {\n      allow read: if isSignedIn()\n        && request.auth.uid == resource.data.referrerId;\n      allow write: if false;\n    }\n\n    match /vouchers/{voucherId} {\n      allow read: if isSignedIn()\n        && request.auth.uid == resource.data.userId;\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-02T13:54:01.313423Z","metadata":{"services":["cloud.firestore"]}}
